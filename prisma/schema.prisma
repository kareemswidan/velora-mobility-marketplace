generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "workerd"
  moduleFormat = "esm"
}

generator nodeClient {
  provider = "prisma-client"
  output   = "../lib/generated/prisma-node"
  runtime  = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String      @default("CUSTOMER")
  bookings     Booking[]
  businesses   Business[] @relation("BusinessOwner")
  favorites    Favorite[]
  reviews      Review[]
  orders       Order[]
  notifications Notification[]
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emailVerifiedAt DateTime?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([email])
}

model Business {
  id              String          @id @default(cuid())
  name            String
  nameAr          String?
  type            String
  description     String
  descriptionAr   String?
  phone           String
  email           String
  website         String?
  logoUrl         String?
  coverUrl        String?
  currency        String          @default("USD")
  status          String  @default("PENDING")
  rejectionReason String?
  ownerId         String
  owner           User            @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stations        Station[]
  services        Service[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([ownerId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  description String?
  descriptionAr String?
  price       Decimal
  duration    Int
  active      Boolean  @default(true)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slots       AvailabilitySlot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

model GasPrice {
  id        String   @id @default(cuid())
  fuelType  String   @unique
  fuelTypeAr String?
  price     Decimal
  unit      String   @default("L")
  updatedAt DateTime @updatedAt
}

model Station {
  id          String    @id @default(cuid())
  name        String
  nameAr      String?
  address     String
  addressAr   String?
  city        String
  cityAr      String?
  country     String    @default("United States")
  countryAr   String?
  timezone    String    @default("UTC")
  latitude    Decimal
  longitude   Decimal
  phone       String
  imageUrl    String?
  openingTime String    @default("00:00")
  closingTime String    @default("23:59")
  open24Hours Boolean   @default(true)
  amenities   String    @default("[]")
  bookings    Booking[]
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  favorites   Favorite[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id           String         @id @default(cuid())
  customerName String
  email        String
  phone        String
  service      String
  scheduledAt  DateTime
  vehicle      String
  notes        String?
  status       String  @default("PENDING")
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  stationId    String
  station      Station        @relation(fields: [stationId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  description String
  descriptionAr String?
  category    String
  categoryAr  String?
  price       Decimal
  stock       Int      @default(0)
  imageUrl    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([category])
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  make      String
  model     String
  plate     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  capacity  Int      @default(1)
  active    Boolean  @default(true)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([serviceId, weekday, startTime])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  stationId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, stationId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, businessId])
  @@index([businessId])
}

model Order {
  id            String        @id @default(cuid())
  status        String   @default("PENDING")
  paymentStatus String @default("UNPAID")
  total         Decimal
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Decimal
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  type      String
  title     String
  message   String
  read      Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}
